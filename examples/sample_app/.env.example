# ==============================================================================
# FastAPI Agent Observability - Template Configuration (.env.example)
# ==============================================================================

# Application & Server Settings
APP_NAME=AI Agent Observability Demo
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database & Tracing Storage
DATABASE_URL=sqlite:///./observability.db
DASHBOARD_PATH=/admin/observability
MAX_PAYLOAD_CHARS=12000
DEFAULT_PAGE_SIZE=50

# Authentication & Access Control
ADMIN_API_KEY=admin-secret-key-123
USER_API_KEY=user-secret-key-456
DEV_MODE_AUTO_ADMIN=false

# Optional LLM API Keys
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
